{
  "name": "pak-files-parser",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/pak-files-parser/src",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": ["data-types"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "compiler": "tsc",
        "outputPath": "dist/packages/pak-files-parser",
        "main": "packages/pak-files-parser/src/main.ts",
        "tsConfig": "packages/pak-files-parser/tsconfig.app.json",
        "format": ["cjs"]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        },
        "beta": {
          "fileReplacements": [
            {
              "replace": "packages/pak-files-parser/src/environments/environment.ts",
              "with": "packages/pak-files-parser/src/environments/environment.beta.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "pak-files-parser:build",
      },
      "configurations": {
        "production": {
          "buildTarget": "pak-files-parser:build:production"
        },
        "beta": {
          "buildTarget": "pak-files-parser:build:beta"
        }
      }
    },
    "prepare": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "pak-files-parser:build",
        "watch": false,
        "inspect": false
      },
      "configurations": {
        "live": {
          "buildTarget": "pak-files-parser:build:production",
          "args": ["--prepare"]
        },
        "beta": {
          "buildTarget": "pak-files-parser:build:beta",
          "args": ["--prepare"]
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
